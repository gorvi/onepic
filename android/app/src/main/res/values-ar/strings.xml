    <string name="app_name">لغز النجوم</string>

    <!-- Intro Story -->
    <string name="intro_prologue">العام 2077. طاقة الأرض نضبت، والحضارة العظيمة ذات يوم تقف على حافة الانقراض.\n\nأنت قائد \"مبادرة السفينة\". أملنا الوحيد في جمع قلوب الطاقة البدائية المنتشرة عبر الكوكب لصنع سفينة تعبر المجرة.\n\nكل لغز يُستعاد يعطي القوة الرقمية لإشعال محركات الالتواء. اجمع الطاقة، أعد بناء المخططات، وقيادة البشرية عبر النجوم لإيجاد وطننا الجديد.</string>
    <string name="intro_button">بدء الرحلة</string>
    
