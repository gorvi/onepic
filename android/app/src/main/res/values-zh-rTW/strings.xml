    <string name="app_name">星際拼圖</string>

    <!-- Intro Story -->
    <string name="intro_prologue">2077年，地球資源枯竭，曾經輝煌的文明已至暮色蒼茫。\n\n你是『方舟計劃』的指揮官。唯一的希望，是蒐集散落在地球各處的原始能量核心，鑄就足以穿越星海的巨型方舟。\n\n每一幅被還原的拼圖，都是點燃躍遷引擎的數位動力。收集能量，重構藍圖，帶領人類跨越璀璨星河，尋找我們的新家園。</string>
    <string name="intro_button">開啟旅程</string>
    
