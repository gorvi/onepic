    <string name="app_name">Quebra-cabeça Estelar</string>

    <!-- Intro Story -->
    <string name="intro_prologue">O ano é 2077. A energia da Terra está esgotada e a outrora grande civilização está à beira da extinção.\n\nVocê é o Comandante da \'Iniciativa da Arca.\' Nossa única esperança está em coletar os núcleos de energia primordiais espalhados pelo globo para forjar uma nave capaz de cruzar a galáxia.\n\nCada quebra-cabeça restaurado fornece o poder digital para acender os motores warp. Reúna a energia, reconstrua os projetos e conduza a humanidade através das estrelas em busca do novo lar.</string>
    <string name="intro_button">Iniciar jornada</string>
    
