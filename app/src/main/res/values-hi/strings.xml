    <!-- Intro Story -->
    <string name="intro_prologue">वर्ष 2077 है। पृथ्वी की ऊर्जा खत्म हो चुकी है, और कभी महान सभ्यता विलुप्त होने के कगार पर है।\n\nआप \'आर्क पहल\' के कमांडर हैं। हमारी एकमात्र उम्मीद दुनिया भर में बिखरे आदि ऊर्जा कोर इकट्ठा कर गैलेक्सी पार करने वाला जहाज बनाना है।\n\nहर बहाल पज़ल वार्प इंजन जलाने की डिजिटल शक्ति देता है। ऊर्जा इकट्ठा करो, नक्शे फिर बनाओ और मानवता को तारों के पार नए घर तक ले चलो।</string>
    <string name="intro_button">यात्रा शुरू करें</string>
    
